
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Allow HTTP validation files without exposing other hidden files.
    RewriteRule ^\.well-known/acme-challenge/ - [L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule (^|/)(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|server\.php)$ - [F,L,NC]

    # Serve public uploads through Laravel's public storage link, not storage/.
    RewriteRule ^storage(?:/(.*))?$ public/storage/$1 [L]

    # Block direct access to application and deployment files.
    RewriteRule ^(app|bootstrap|config|database|deploy|docs|resources|routes|scripts|tests|vendor|node_modules)(/.*)?$ - [F,L,NC]

    # Do not rewrite requests already under public/
    RewriteRule ^public(/|$) - [L]

    # Route all requests to public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
